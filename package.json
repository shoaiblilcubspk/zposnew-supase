{
  "name": "zaynahs-pos",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "description": "Zaynahs POS — Supabase-only, cloud-direct, server-authoritative POS with a local SQLite cache + sync queue, built with React, TypeScript, SQLite, Electron, and Capacitor",
  "keywords": [
    "pos",
    "point-of-sale",
    "cloud-direct",
    "supabase",
    "sqlite",
    "electron",
    "capacitor",
    "react",
    "typescript"
  ],
  "author": "Zaynahs POS Team <zaynahspos@gmail.com> (https://zaynahspos.com)",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "for f in tests/*.mjs; do npx tsx \"$f\" || exit 1; done",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.electron.json && cp dist-electron/main.js dist-electron/main.cjs && cp dist-electron/preload.js dist-electron/preload.cjs",
    "electron:dev": "npm run electron:compile && concurrently -k \"vite --host\" \"wait-on http://localhost:5173 && NODE_ENV=development ELECTRON_DISABLE_SECURITY_WARNINGS=true electron .\"",
    "electron:build": "vite build && npm run electron:compile && electron-builder",
    "electron:pack": "vite build && npm run electron:compile && electron-builder --dir",
    "cap": "cap",
    "ios:sync": "vite build && cap sync ios",
    "ios:open": "cap open ios",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@electron/remote": "^2.1.2",
    "@noble/hashes": "^2.4.0",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/jszip": "^3.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "dexie": "^4.4.2",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.1",
    "react-to-print": "^3.3.0",
    "recharts": "^2.8.0",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.9.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/electron": "^1.6.10",
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^32.0.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.zaynahs.pos",
    "productName": "Zaynahs POS",
    "artifactName": "Zaynahs-POS-v${version}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-electron/preload.cjs",
        "to": "preload.cjs"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src-electron/icons/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src-electron/icons/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src-electron/icons/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Zaynahs-POS-v${version}-Setup.${ext}"
    }
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
